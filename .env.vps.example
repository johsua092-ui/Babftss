# ======================================================================
# BABFT API — .env untuk VPS (Express server/index.js)
# Copy ke /app/.env di VPS, isi nilai asli (JANGAN commit .env asli)
# ======================================================================

PORT=3000

# ── Turso / libSQL (gold, marketplace, inbox, announcements, audit_log) ──
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Supabase (quiz, progress, leaderboard, profile, favorites) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase Admin — project punya-si-jawa (canvas, analytics) ──
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase Admin — project backend-fb691 (Auth ID token verify) ──
FIREBASE_PROJECT_ID_SERVER=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── AI / Overchat ──
OVERCHAT_API_URL=https://api.overchat.ai/v1/chat/completions
OVERCHAT_ORIGIN=https://overchat.ai
AI_MODEL=claude-haiku-4-5-20251001

# ── CORS ──
ALLOWED_CORS_ORIGINS=https://babftss.vercel.app

# ── Admin ──
ADMIN_EMAILS=
ADMIN_UIDS=
