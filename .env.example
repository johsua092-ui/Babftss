# ======================================================================
# BABFT Learning - Environment Variables Template
# ======================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit real credentials to the repository.
#
# Usage in code (Vite): import.meta.env.VITE_VARIABLE_NAME
# Usage in API routes (server-side only): process.env.VARIABLE_NAME
# ======================================================================

# --- Firebase Auth (client-side - PUBLIC config, not secrets) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Supabase (client-side - PUBLIC anon key only) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Server-side ONLY (NEVER expose to browser) ---

# Firebase Admin SDK (server-side)
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\"
FIREBASE_PROJECT_ID_SERVER=your-project-id

# Supabase Service Role Key (server-side - FULL ACCESS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# --- AI / Overchat Configuration ---
OVERCHAT_API_URL=https://api.overchat.ai/v1/chat/completions
OVERCHAT_ORIGIN=https://overchat.ai
AI_MODEL=claude-haiku-4-5-20251001

# --- CORS Origins (comma-separated, no spaces) ---
ALLOWED_CORS_ORIGINS=https://babftss.vercel.app,https://babftlearning.dpdns.org,https://babft-project.vercel.app

# --- Pterodactyl / Container ---
# PORT is auto-injected by Pterodactyl as SERVER_PORT.
# Only set PORT manually for Docker or local dev.
PORT=3000
