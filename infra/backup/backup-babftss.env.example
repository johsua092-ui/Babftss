# ============================================================================
# BABFTSS Backup — Environment Configuration
# ============================================================================
# Copy this file to /etc/babftss/backup.env and fill in real values.
# After editing: chmod 600 /etc/babftss/backup.env   (PROTECT CREDENTIALS!)
# ============================================================================

# ── Turso (libSQL) ──────────────────────────────────────────────────────────
# From app.turso.tech → your database → Settings
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────
# From supabase.com/dashboard → your project → Database → Settings → Connection → Connection string (URI)
# Use the DIRECT connection (port 5432), not the pooler (port 6543), for pg_dump.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-password@db.abcdefghijklm.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your-password

# ── S3-compatible storage (Cloudflare R2 / Backblaze B2 / AWS S3 / GCS) ────
# RECOMMENDED: Cloudflare R2 (free egress, $0.015/GB-month storage)
#   1. Create bucket at https://dash.cloudflare.com → R2
#   2. Generate API token with read+write permission on the bucket
#   3. Fill in below:
S3_BUCKET=babftss-backups
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_REGION=auto
# For R2:     https://[ACCOUNT-ID].r2.cloudflarestorage.com
# For B2:     https://s3.[REGION].backblazeb2.com
# For AWS S3: leave empty (use default)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ── Retention ───────────────────────────────────────────────────────────────
RETENTION_DAYS=30

# ── Local backup dir + log ──────────────────────────────────────────────────
LOCAL_BACKUP_DIR=/var/backups/babftss
LOG_FILE=/var/log/babftss-backup.log

# ── Optional: Firebase Firestore backup (set true to enable) ────────────────
BACKUP_FIRESTORE=false
FIRESTORE_PROJECT_ID=punya-si-jawa
# GCS bucket to receive Firestore export (must already exist)
FIRESTORE_GCS_BUCKET=babftss-firestore-backups

# ── Optional: Discord/Slack webhook for alerts ─────────────────────────────
# Leave empty to disable alerts
DISCORD_WEBHOOK=
